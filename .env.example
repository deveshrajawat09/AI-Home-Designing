# Backend Environment Configuration

# Server
NODE_ENV=development
PORT=5001

# Database (Future: when migrating to MongoDB/PostgreSQL)
# DATABASE_URL=mongodb://localhost:27017/homeplanner
# DB_USERNAME=user
# DB_PASSWORD=password

# JWT
JWT_SECRET=your-secret-key-change-in-production-min-32-chars-long-very-secure

# CORS - allowed origins for the web client (dev uses Vite on 5173)
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://example.com

# Google Generative AI
GOOGLE_API_KEY=your-google-api-key-here

# Email Service (Optional)
# SENDGRID_API_KEY=your-sendgrid-key
# SENDER_EMAIL=noreply@example.com

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# Session & Security
SESSION_TIMEOUT_HOURS=24
BCRYPT_ROUNDS=10

# File Upload (Optional)
# MAX_FILE_SIZE=5242880
# UPLOAD_DIR=./uploads
