import { useEffect, useMemo, useState } from "react";
import { generatePlan, listPlans, savePlan, deletePlan } from "./api";
import { usePlanStore } from "./store";
import CanvasView from "./components/CanvasView";
import ThreePreview from "./components/ThreePreview";

const defaultLand = { length: 10, width: 15, shape: "rectangle", pointsText: "" };

const parsePoints = (text) =>
  text
    .split(";")
    .map((p) => p.trim())
    .filter(Boolean)
    .map((pair) => {
      const [x, y] = pair.split(",").map(Number);
      if (Number.isFinite(x) && Number.isFinite(y)) return { x, y };
      return null;
    })
    .filter(Boolean);

export default function App() {
  const { plan, setPlan, loading, setLoading, error, setError, saved, setSaved } = usePlanStore();
  const [land, setLand] = useState(defaultLand);
  const [editable, setEditable] = useState(false);
  const [show3d, setShow3d] = useState(false);
  const [dark, setDark] = useState(false);
  const [saveName, setSaveName] = useState("My Layout");

  useEffect(() => {
    document.documentElement.classList.toggle("dark", dark);
  }, [dark]);

  useEffect(() => {
    listPlans().then(setSaved).catch(() => {});
  }, [setSaved]);

  const area = useMemo(() => land.length * land.width, [land]);
  const cost = area * 1000;

  const handleGenerate = async () => {
    setLoading(true);
    setError(null);
    try {
      const points = land.shape === "irregular" ? parsePoints(land.pointsText) : [];
      const generated = await generatePlan({
        length: Number(land.length),
        width: Number(land.width),
        shape: land.shape,
        points
      });
      setPlan(generated);
    } catch (e) {
      setError(e.message || "Failed");
    } finally {
      setLoading(false);
    }
  };

  const loadSample = () => {
    setLand({ length: 10, width: 15, shape: "rectangle", pointsText: "" });
    setPlan(null);
    handleGenerate();
  };

  const handleSave = async () => {
    if (!plan) return;
    const record = await savePlan({ name: saveName || "Untitled", plan, land });
    const fresh = await listPlans();
    setSaved(fresh);
    setSaveName(record.name);
  };

  const handleLoad = async (rec) => {
    setPlan(rec.plan);
    setLand(rec.land || land);
  };

  const handleDelete = async (id) => {
    await deletePlan(id);
    setSaved(await listPlans());
  };

  return (
    <div className="min-h-screen bg-gradient-to-b from-gray-50 via-white to-gray-100 dark:from-gray-900 dark:via-gray-900 dark:to-black">
      <header className="max-w-6xl mx-auto px-4 py-6 flex items-center gap-3">
        <h1 className="text-2xl font-semibold text-indigo-600 dark:text-indigo-300">HomePlanner AI</h1>
        <span className="px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 text-xs dark:bg-emerald-900/40 dark:text-emerald-200">
          Floor & 3D generator
        </span>
        <div className="ml-auto flex items-center gap-2 text-sm">
          <label className="flex items-center gap-2 cursor-pointer">
            <span>Dark</span>
            <input type="checkbox" checked={dark} onChange={() => setDark((d) => !d)} />
          </label>
        </div>
      </header>

      <main className="max-w-6xl mx-auto px-4 pb-10 space-y-6">
        <section className="grid md:grid-cols-3 gap-4">
          <div className="md:col-span-2">
            <CanvasView plan={plan} editable={editable} land={land} />
            <ThreePreview plan={plan} visible={show3d} />
          </div>

          <aside className="space-y-4">
            <div className="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4 shadow-sm">
              <h3 className="font-semibold mb-3">Measurements</h3>
              <div className="space-y-3 text-sm">
                <label className="flex flex-col">
                  Length (m)
                  <input
                    type="number"
                    min="5"
                    className="mt-1 rounded border px-2 py-1 bg-white dark:bg-gray-900"
                    value={land.length}
                    onChange={(e) => setLand({ ...land, length: Number(e.target.value) })}
                  />
                </label>
                <label className="flex flex-col">
                  Width (m)
                  <input
                    type="number"
                    min="5"
                    className="mt-1 rounded border px-2 py-1 bg-white dark:bg-gray-900"
                    value={land.width}
                    onChange={(e) => setLand({ ...land, width: Number(e.target.value) })}
                  />
                </label>
                <label className="flex flex-col">
                  Shape
                  <select
                    className="mt-1 rounded border px-2 py-1 bg-white dark:bg-gray-900"
                    value={land.shape}
                    onChange={(e) => setLand({ ...land, shape: e.target.value })}
                  >
                    <option>rectangle</option>
                    <option>L-shape</option>
                    <option>irregular</option>
                  </select>
                </label>
                {land.shape === "irregular" && (
                  <label className="flex flex-col text-xs gap-1">
                    Polygon points (x,y;...)
                    <textarea
                      className="rounded border px-2 py-1 bg-white dark:bg-gray-900"
                      placeholder="0,0;10,0;10,15;0,15"
                      value={land.pointsText}
                      onChange={(e) => setLand({ ...land, pointsText: e.target.value })}
                    />
                    <span className="text-gray-500">Meters, separated by semicolons.</span>
                  </label>
                )}
                <button
                  onClick={handleGenerate}
                  className="w-full py-2 rounded bg-indigo-600 text-white hover:bg-indigo-500"
                  disabled={loading}
                >
                  {loading ? "Generating…" : "Generate Plan"}
                </button>
                <button
                  onClick={loadSample}
                  className="w-full py-2 rounded border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-900"
                >
                  Use Sample 10x15
                </button>
                {error && <p className="text-red-500 text-xs">Error: {error}</p>}
              </div>
            </div>

            <div className="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4">
              <h3 className="font-semibold mb-2">Edit & View</h3>
              <div className="flex items-center justify-between text-sm mb-2">
                <label className="flex items-center gap-2">
                  <input type="checkbox" checked={editable} onChange={() => setEditable((v) => !v)} />
                  Edit mode (drag/resize)
                </label>
              </div>
              <div className="flex items-center justify-between text-sm">
                <label className="flex items-center gap-2">
                  <input type="checkbox" checked={show3d} onChange={() => setShow3d((v) => !v)} />
                  3D preview (lazy load)
                </label>
              </div>
            </div>

            <div className="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4 space-y-3">
              <h3 className="font-semibold">Save / Load</h3>
              <div className="flex gap-2 text-sm">
                <input
                  className="flex-1 rounded border px-2 py-1 bg-white dark:bg-gray-900"
                  placeholder="Plan name"
                  value={saveName}
                  onChange={(e) => setSaveName(e.target.value)}
                />
                <button
                  onClick={handleSave}
                  disabled={!plan}
                  className="px-3 rounded bg-emerald-600 text-white"
                >
                  Save
                </button>
              </div>
              <div className="space-y-2 max-h-40 overflow-auto text-sm">
                {saved.length === 0 && <p className="text-gray-500">No saved layouts yet.</p>}
                {saved.map((rec) => (
                  <div key={rec.id} className="flex items-center gap-2">
                    <button
                      className="flex-1 text-left underline"
                      onClick={() => handleLoad(rec)}
                    >
                      {rec.name}
                    </button>
                    <button
                      className="text-xs text-red-500"
                      onClick={() => handleDelete(rec.id)}
                    >
                      delete
                    </button>
                  </div>
                ))}
              </div>
            </div>

            <div className="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4">
              <h3 className="font-semibold mb-2">Cost Estimate</h3>
              <p className="text-sm text-gray-600 dark:text-gray-300">Area: {area} sqm</p>
              <p className="text-lg font-semibold text-emerald-600 dark:text-emerald-300">
                ˜ ${cost.toLocaleString()}
              </p>
              <p className="text-xs text-gray-500">Assuming $1000 per sqm</p>
            </div>
          </aside>
        </section>
      </main>
    </div>
  );
}
